WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// Basic primitives
ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
bool_val = { "true" | "false" }

// Policy Block: policy { deny egress if tainted; }
policy_stmt = { "deny" ~ ident ~ "if" ~ ident ~ ";" }
policy_block = { "policy" ~ "{" ~ policy_stmt ~ "}" }

// Function Block: fn process_data() taint(true) egress(true) { }
effect = { ident ~ "(" ~ bool_val ~ ")" }
fn_decl = { "fn" ~ ident ~ "()" ~ effect* ~ "{" ~ "}" }

// Root program
program = { SOI ~ policy_block ~ fn_decl* ~ EOI }
