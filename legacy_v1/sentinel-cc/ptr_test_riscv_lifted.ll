  %5 = load ptr, ptr %3, align 8
  %6 = load i64, ptr %4, align 8
  call void asm sideeffect ".insn r 0x0B, 0x0, 0x01, x0, $0, $1", "r,r"(ptr %5, i64 %6) #4, !srcloc !11
  ret void
}

